{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "UCRT64 Build",
      "type": "cppvsdbg", // Or "cmake" or appropriate debugger type
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "D:\\development\\msys64\\ucrt64.exe",
      "args": [
        "-c",
        "cd /d/development/dunedynasty; bash /d/development/dunedynasty/scripts/build-debug-windows-x64.sh"
      ],
      "stopAtEntry": false,
      "console": "externalTerminal" // Opens the shell in a new window
    },
    {
    "name": "(gdb) Launch",
    "type": "cppdbg",
    "request": "launch",
    "program": "D:/development/dunedynasty/dist/dunedynasty.exe",
    "args": ["--windowed"],
    "stopAtEntry": false,
    "cwd": "${workspaceFolder}",
    "environment": [],
    "externalConsole": true,
    "MIMode": "gdb",
    "miDebuggerPath": "D:/development/msys64/mingw64/bin/gdb.exe",
    "setupCommands": [
        {
            "description": "Abilita la riformattazione per gdb",
            "text": "-enable-pretty-printing",
            "ignoreFailures": true
        }
    ]
}
  ]
}
