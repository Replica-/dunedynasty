{
  "version": "0.2.0",
  "configurations": [

    // ─────────────────────────  🔨 Build  ─────────────────────────

    {
      "name": "🔨 Build (UCRT64)",
      "type": "cppvsdbg",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "cmd",
      "args": [
        "/c",
        "D:\\development\\msys64\\msys2_shell.cmd",
        "-ucrt64",
        "-defterm",
        "-no-start", "-here",
        "-c",
        "cd /d/development/dunedynasty/ && bash /d/development/dunedynasty/scripts/build-debug-windows-x64.sh"
      ],
      "presentation": { "group": "1 Build", "order": 1 }
    },

    // ─────────────────────  🧪 Regression tests  ─────────────────────
    // Each --test-* scenario (colour menu, Previous, mentat screens, Death Hand,
    // worms, ...) plays itself and quits.  A crash or hang fails only its own test.
    // Screenshots and a summary go to %TEMP%\dd-regression.

    {
      "name": "🧪 Regression tests",
      "type": "cppvsdbg",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\regression-tests.ps1"],
      "console": "externalTerminal",
      "presentation": { "group": "2 Test", "order": 1 }
    },
    {
      "name": "🔨🧪 Build + Regression tests",
      "type": "cppvsdbg",
      "request": "launch",
      "preLaunchTask": "UCRT64 Build",
      "cwd": "${workspaceFolder}",
      "program": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\regression-tests.ps1"],
      "console": "externalTerminal",
      "presentation": { "group": "2 Test", "order": 2 }
    },
    {
      "name": "🐢 Regression tests (including slow ones)",
      "type": "cppvsdbg",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\regression-tests.ps1", "-Slow"],
      "console": "externalTerminal",
      "presentation": { "group": "2 Test", "order": 3 }
    },

    // ───────────────────────  🐞 Debug the game  ───────────────────────

    {
      "name": "🐞 Debug",
      "type": "cppdbg",
      "request": "launch",
      "program": "D:/development/dunedynasty/dist/dunedynasty.exe",
      "args": ["--windowed"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "D:/development/msys64/mingw64/bin/gdb.exe",
      "setupCommands": [
        { "description": "xx", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ],
      "presentation": { "group": "3 Debug", "order": 1 }
    },
    {
      "name": "🔨🐞 Build + Debug",
      "type": "cppdbg",
      "request": "launch",
      "preLaunchTask": "UCRT64 Build",
      "program": "D:/development/dunedynasty/dist/dunedynasty.exe",
      "args": ["--windowed"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "D:/development/msys64/mingw64/bin/gdb.exe",
      "setupCommands": [
        { "description": "xx", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ],
      "presentation": { "group": "3 Debug", "order": 2 }
    },

    // ─────────────────  🏜️ Jump straight into a mission  ─────────────────

    {
      "name": "🏜️ Debug: Mission 9 Atreides",
      "type": "cppdbg",
      "request": "launch",
      "program": "D:/development/dunedynasty/dist/dunedynasty.exe",
      "args": ["--windowed", "--house", "atreides", "--mission", "9"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "D:/development/msys64/mingw64/bin/gdb.exe",
      "setupCommands": [
        { "description": "xx", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ],
      "presentation": { "group": "4 Missions", "order": 1 }
    },
    {
      "name": "🔨🏜️ Build + Debug: Mission 9 Atreides",
      "type": "cppdbg",
      "request": "launch",
      "preLaunchTask": "UCRT64 Build",
      "program": "D:/development/dunedynasty/dist/dunedynasty.exe",
      "args": ["--windowed", "--house", "atreides", "--mission", "9"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "D:/development/msys64/mingw64/bin/gdb.exe",
      "setupCommands": [
        { "description": "xx", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ],
      "presentation": { "group": "4 Missions", "order": 2 }
    },

    // ─────────────────  ✨ OpenGL post-processing shader  ─────────────────
    // Edits to dist/gfx/post.frag (GLSL) apply on the next launch.

    {
      "name": "✨ Debug: OpenGL shader (--gl-post)",
      "type": "cppdbg",
      "request": "launch",
      "program": "D:/development/dunedynasty/dist/dunedynasty.exe",
      "args": ["--windowed", "--gl-post"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "D:/development/msys64/mingw64/bin/gdb.exe",
      "setupCommands": [
        { "description": "xx", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ],
      "presentation": { "group": "5 OpenGL", "order": 1 }
    },

    // ─────────────────  👀 Show me: effects and voices  ─────────────────
    // Visible, with sound.  Mission 5 as Atreides has units to click and fight
    // with.  The hardware effects (explosions, smoke, sandstorms) need the OpenGL
    // driver and Options > Game Controls > Hardware effects on; radio voices are
    // Options > Game Controls > Radio voices.

    {
      "name": "🌪️ Show: sandstorm (stays on)",
      "type": "cppdbg",
      "request": "launch",
      "program": "D:/development/dunedynasty/dist/dunedynasty.exe",
      "args": ["--windowed", "--house", "atreides", "--mission", "5", "--sandstorm-now"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": true,
      "MIMode": "gdb",
